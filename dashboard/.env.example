# nff-app environment — the template. Copy to .env.local.dev and fill in.
#
# THREE files, no more:
#   .env.example      this file (committed, no values)
#   .env.local.dev    local dev — `npm run dev` runs `vite --mode local.dev` (gitignored)
#   .env.production   the prod build — `vite build` loads it (committed, no secrets in it)
#
# VITE_-prefixed vars are baked into the browser bundle. Everything else is
# server-side only (api/ functions + the vite.config.ts dev middlewares) and must
# never gain a VITE_ prefix.

# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role: server-side only. Bypasses RLS — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── The admin API this app proxies to (/admin-api rewrite) ──────────────────
# Dev: point at nff-admin's dev server. Prod sets it in .env.production.
VITE_ADMIN_API_BASE=

# ── Platform services (server-side) ─────────────────────────────────────────
NFF_FLEET_URL=
NFF_FLEET_SECRET=
NFF_FLEET_WS_URL=
NFF_OTA_URL=
NFF_MOCKCTL_URL=
NFF_MOCKCTL_CONTROL_SECRET=

# ── GitHub add-on ───────────────────────────────────────────────────────────
NFF_GITHUB_INTERNAL_URL=
NFF_GITHUB_INTERNAL_SECRET=
NFF_GITHUB_APP_SLUG=
NFF_ADMIN_ORIGIN=

# ── Bench-local ─────────────────────────────────────────────────────────────
# The fleet broker's LAN address handed to a device moving to WiFi (host:port).
VITE_NFF_WIFI_BROKER=
# Dev-only Security tab.
PENTESTER_DEV_MODE=
VITE_PENTESTER_DEV_MODE=

# ── Playwright e2e (playwright.config.ts reads this file) ───────────────────
# A real account on the DEV Supabase project.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
