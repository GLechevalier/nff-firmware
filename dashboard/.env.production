# Baked into Vercel builds (vite mode=production). The embedded admin add-ons
# (src/core/lib/api.ts) reach the admin deployment through vercel.json's
# /admin-api rewrite — without this the brain card & co. fetch this app's own
# /api and get index.html back. Contains no secrets; committed on purpose
# (.gitignore negates it). nff-admin's own build must NOT set this (same-origin).
VITE_ADMIN_API_BASE=/admin-api

# ── Chat quick acknowledgement ──────────────────────────────────────────────
# Powers POST /api/chat/ack (api/_chatAck.ts, dispatched by api/account.ts): one
# fast Haiku call that restates the question while the agent worker spins up.
# OPTIONAL — unset, the endpoint returns {ack:null} and the chat simply shows no
# ack line. This is a Messages-API key, unrelated to ANTHROPIC_ADMIN_KEY (usage
# reports). It must NOT be a VITE_ var: it stays server-side.
ANTHROPIC_API_KEY=
