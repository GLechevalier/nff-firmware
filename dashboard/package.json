{
  "name": "nff-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode local.dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:demo": "playwright test --project=public",
    "test:e2e:live": "playwright test --project=live",
    "test:e2e:heal": "cross-env RUN_HEAL=1 playwright test --project=live-heal",
    "test:track2": "echo Literal git-push Track-2 is the Python harness. See tests/README.md (run: cd ../e2e && python run_nightly.py)",
    "test:seed-user": "node scripts/seed-test-user.mjs",
    "build:firmware": "node scripts/build-firmware.mjs",
    "build:firmware:check": "node scripts/build-firmware.mjs --check",
    "demo:firmware": "node scripts/sync-demo-firmware.mjs",
    "demo:firmware:check": "node scripts/sync-demo-firmware.mjs --check",
    "db:check": "npm --prefix ../nff-db run db:check",
    "db:dump": "npm --prefix ../nff-db run db:dump",
    "db:migrate": "npm --prefix ../nff-db run db:migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@gitgraph/react": "^1.6.0",
    "@huggingface/transformers": "^3.8.1",
    "@monaco-editor/react": "^4.7.0",
    "@nff-brain/core": "file:vendor/nff-brain-core-0.1.2.tgz",
    "@supabase/supabase-js": "^2.107.0",
    "@tiptap/extension-highlight": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@types/w3c-web-serial": "^1.0.8",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.11.2",
    "croner": "^9.1.0",
    "esptool-js": "^0.6.0",
    "lucide-react": "^1.34.0",
    "monaco-editor": "^0.52.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pg": "^8.13.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
